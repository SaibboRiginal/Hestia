# Hecate configuration
# Copy to .env and fill secrets.

# ── Core service routing ───────────────────────────────────────────────
HUB_API_URL=http://hestia_hub:19001/api
HECATE_SERVICE_BASE_URL=http://hestia_hecate:19003
HECATE_SERVICE_VERSION=1.0.0

# ── Tunables (backfill days, Archive timeouts, auth re-check, notify cooldown, log level)
# are central settings (Themis, keys hecate.*): change them from WebUI/Telegram, not here.

# ── Provider toggles (optional; deployment choice tied to the credentials below) ──
HECATE_ENABLE_PROVIDER_GOOGLE=false
HECATE_ENABLE_PROVIDER_MICROSOFT=false

# ── Google provider (OAuth or service account) ────────────────────────
# OAuth client type: "Desktop app". Consent screen: "In production" (Testing = token dies in 7 days).
# Only CLIENT_ID + CLIENT_SECRET are needed; authorize from Telegram ("collega Google Calendar")
# or google-oauth.bat / google-oauth.sh. The token lands in data/google_token.json.
# Redirect: leave empty → Cloudflare tunnel URL (data/tunnel-url.txt, cloudflare-tunnel.bat) → localhost.
# Set only for a fixed public URL (named tunnel/domain).
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_FLOW_MODE=redirect
# Default: calendar + gmail.readonly + gmail.send (mail only via OAuth token, no IMAP).
GOOGLE_OAUTH_SCOPES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_JSON=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Microsoft provider ────────────────────────────────────────────────
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=consumers
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_USER_ID=me

# ── Mail: Gmail via the Google OAuth token above (no IMAP / app password).
# ── Logging ────────────────────────────────────────────────────────────
# Boot level only; at runtime the level is the central setting hecate.log.level.
LOG_LEVEL=INFO