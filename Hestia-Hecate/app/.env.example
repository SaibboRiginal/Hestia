# Hecate configuration
# Copy to .env and fill secrets.

# ── Core service routing ───────────────────────────────────────────────
HUB_API_URL=http://hestia_hub:19001/api
HECATE_SERVICE_BASE_URL=http://hestia_hecate:19003
HECATE_SERVICE_VERSION=1.0.0

# ── Tunables (backfill days, Archive timeouts, auth re-check, notify cooldown, log level)
# are central settings (Themis, keys hecate.*): change them from WebUI/Telegram, not here.

# ── Provider toggles (optional; deployment choice tied to the credentials below) ──
HECATE_ENABLE_PROVIDER_GOOGLE=false
HECATE_ENABLE_PROVIDER_MICROSOFT=false

# ── Google provider (OAuth or service account) ────────────────────────
# OAuth client type: "Desktop app". Consent screen: "In production" (Testing = token dies in 7 days).
# The client is typed in WebUI → Connections → Google (Hestia writes HECATE_KEY_GOOGLE_CLIENT_ID/SECRET here);
# the token lands in data/google_token.json.
# Redirect: leave empty → Cloudflare tunnel URL (data/tunnel-url.txt, cloudflare-tunnel.bat) → localhost.
# Set only for a fixed public URL (named tunnel/domain).
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_FLOW_MODE=redirect
# Default: calendar + gmail.readonly + gmail.send + drive.file (mail only via OAuth token, no IMAP; drive.file =
# only the files Hestia creates, its .hestia folder for the backup: enable the Google Drive API in the project).
GOOGLE_OAUTH_SCOPES=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_JSON=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Keys written by Hestia from WebUI → Connections (never by hand): ────
# HECATE_KEY_GOOGLE_CLIENT_ID / _SECRET (Google), HECATE_KEY_OUTLOOK_CLIENT_ID / _TENANT / _CLIENT_SECRET (Outlook;
# its sign-in token goes to data/outlook_token.json), HECATE_KEY_GMAIL_PUBSUB_ACCOUNT (Gmail instant notices),
# HECATE_KEY_PHONE (the Android phone's key).

# ── Mail: Gmail via the Google OAuth token above (no IMAP / app password).
# ── Logging ────────────────────────────────────────────────────────────
# Boot level only; at runtime the level is the central setting hecate.log.level.
LOG_LEVEL=INFO
# ── Outbound MCP servers (third-party MCP servers Hestia may use; shown on WebUI → Accessi AI → Servizi esterni) ──
# Two keys per server: the address and, if the server needs one, its key (sent as Authorization: Bearer).
# HECATE_MCP_<NAME>_URL=https://mcp.example.com/mcp
# HECATE_MCP_<NAME>_KEY=

# ── Devices (dossier docs/work/2026-10-24-whole-cindy-brainstorm W4) ──
# Garmin Connect: easiest is «Collega Garmin» (Telegram/WebUI secret form, password never stored).
# Or set them here: used once to get the tokens, kept in HECATE_GARMIN_TOKENS (data folder).
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# HECATE_GARMIN_TOKENS=/code/data/garmin
# Android phone as a sensor (Tasker/MacroDroid → POST /api/gateway/phone/push, header X-Hestia-Phone-Token): its key is
# created in WebUI → Connections → Android phone (HECATE_KEY_PHONE above).
