{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hestia.WebUI": "Information"
    }
  },
  "WebUI": {
    "Port": 19015,
    "SecretKey": "",
    "TokenLifetimeHours": 72,
    "RateLimitPerMinute": 60,
    "MaxUploadSizeMB": 50,
    "CorsOrigin": "*",
    "StaticDir": "wwwroot",
    "OracleClientInstructions": "FORMAT (the answer is shown on a web page that renders Markdown). Write GitHub-flavoured Markdown: **bold**, lists with -, tables when comparing, [descriptive text](url) for links. No raw HTML tags. Bold only for the key information."
  },
  "Hestia": {
    "HubApiUrl": "http://hestia_hub:19001/api",
    "ServiceName": "webui",
    "ServiceBaseUrl": "http://hestia_webui:19015",
    "ServiceVersion": "1.0.0",
    "ServiceType": "integration",
    "ServiceTags": "integration,messaging,chat",
    "ServiceTopologyTags": "layer:client,domain:ui,status:stable"
  }
}
