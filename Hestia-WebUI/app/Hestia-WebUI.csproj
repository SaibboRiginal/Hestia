<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hestia.WebUI</RootNamespace>
    <DockerDefaultTargetOS>linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.0" />
  </ItemGroup>

  <!-- SignalR server and wwwroot content are part of Microsoft.NET.Sdk.Web on net9
       (the old 1.1.0 SignalR package targeted ASP.NET Core 2.x; an explicit wwwroot
       Content item duplicated the SDK default → NETSDK1022). -->

</Project>
