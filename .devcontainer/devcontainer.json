// GitHub Codespaces: the whole Hestia stack as a test bench you open from the browser (also phone).
// Start: Code → Codespaces → «…» → New with options (4-core): the page asks for the secrets below (all optional).
// On every start it runs `python tools/cloud_test.py start`: build/start the stack, login link in .cloud-test/login.txt,
// full output in .cloud-test/start.log (look there if the link does not appear).
// Ports stay private (only your GitHub account). Docs: TESTING.md «Banco di prova cloud».
{
  "name": "Hestia — banco di prova",
  // Debian 12: the plain 3.12 tag moved to Debian 13 (trixie), where docker-in-docker (moby) does not install
  // and the Codespace falls back to recovery mode without Docker.
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [19015, 19000],
  "portsAttributes": {
    "19015": { "label": "WebUI", "onAutoForward": "notify" },
    "19000": { "label": "Swagger", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "secrets": {
    "GEMINI_API_KEY": { "description": "Real answers from Gemini instead of the fake LLM. Key from aistudio.google.com/apikey.",
                        "documentationUrl": "https://aistudio.google.com/apikey" },
    "TELEGRAM_BOT_TOKEN": { "description": "A TEST bot from @BotFather (/newbot), not your real one." },
    "ALLOWED_USER_ID": { "description": "Your numeric Telegram id (ask @userinfobot): the test bot answers only you." },
    "GOOGLE_CLIENT_ID": { "description": "Temporary Google OAuth client, type Desktop app (Calendar + Gmail API on, you as test user)." },
    "GOOGLE_CLIENT_SECRET": { "description": "Secret of the same temporary Google OAuth client." }
  },
  "postCreateCommand": "python tools/cloud_test.py prepare",
  "postStartCommand": "mkdir -p .cloud-test && python tools/cloud_test.py start 2>&1 | tee .cloud-test/start.log"
}
