# Copy to .env (gitignored). Secrets and infrastructure only:
# models, log level and other tunables are settings (WebUI → Impostazioni → Oracle, stored by Themis).
GEMINI_API_KEY=
# Embeddings are truncated+renormalized to ORACLE_EMBED_DIM (Archive = 768)
ORACLE_EMBED_DIM=768

# Forge engines need nothing extra: "local" = Ollama + the code model setting,
# "cloud" = Gemini (code model or its fallback setting) + GEMINI_API_KEY.
# Claude subscription (optional): token from `claude setup-token`. Used by Forge and by the
# chat provider "Claude (abbonamento)" (same usage limits; needs ORACLE_INSTALL_CLAUDE_CODE=1).
# CLAUDE_CODE_OAUTH_TOKEN=

# Claude API key (optional, pay per use) for the chat provider "Claude (chiave API)".
# Never name it ANTHROPIC_API_KEY: Forge's Claude Code would switch to paid API billing.
# ORACLE_ANTHROPIC_API_KEY=
