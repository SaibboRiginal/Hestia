# Copy to .env (gitignored). Secrets stay local.
GEMINI_API_KEY=
LOG_LEVEL=INFO

# Use cases: PROVIDER / MODEL / FALLBACK_PROVIDER / FALLBACK_MODEL (ollama | gemini)
MODEL_USECASE_GENERIC_PROVIDER=ollama
MODEL_USECASE_GENERIC_MODEL=gemma4:e4b
MODEL_USECASE_GENERIC_FALLBACK_PROVIDER=gemini
MODEL_USECASE_GENERIC_FALLBACK_MODEL=gemini-2.0-flash-lite
MODEL_USECASE_REASONING_PROVIDER=ollama
MODEL_USECASE_REASONING_MODEL=gemma4:e4b
MODEL_USECASE_REASONING_FALLBACK_PROVIDER=gemini
MODEL_USECASE_REASONING_FALLBACK_MODEL=gemini-2.5-flash
MODEL_USECASE_CODE_PROVIDER=ollama
MODEL_USECASE_CODE_MODEL=gemma4:e4b
MODEL_USECASE_CODE_FALLBACK_PROVIDER=gemini
MODEL_USECASE_CODE_FALLBACK_MODEL=gemini-2.0-flash
# Embeddings are truncated+renormalized to ORACLE_EMBED_DIM (Archive = 768)
MODEL_USECASE_EMBEDDING_PROVIDER=ollama
MODEL_USECASE_EMBEDDING_MODEL=qwen3-embedding:0.6b
MODEL_USECASE_EMBEDDING_FALLBACK_PROVIDER=gemini
MODEL_USECASE_EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
ORACLE_EMBED_DIM=768

# Forge "cloud" engine via /api/llm/chat (OpenAI-compatible), optional
# ORACLE_LLM_PROFILE_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ORACLE_LLM_PROFILE_CLOUD_MODEL=gemini-2.5-flash
# ORACLE_LLM_PROFILE_CLOUD_API_KEY=
# Claude Code (Pro) for Forge code tasks: `claude setup-token`; build with INSTALL_CLAUDE_CODE=1
# CLAUDE_CODE_OAUTH_TOKEN=
