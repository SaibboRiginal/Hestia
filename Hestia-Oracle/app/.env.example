# Copy to .env (gitignored). Secrets and infrastructure only:
# providers, chains, use cases, log level and other tunables are settings (WebUI → Oracle → Cervello → Modelli and
# Impostazioni → Sistema → Oracle, stored by Themis).
# Embeddings are truncated+renormalized to ORACLE_EMBED_DIM (Archive = 768)
ORACLE_EMBED_DIM=768

# Provider keys: one line per named provider that needs one, ORACLE_KEY_<NAME> (name upper-case, "-" → "_").
# A provider without its key is skipped by every chain. Default providers:
# ORACLE_KEY_GEMINI=
# ORACLE_KEY_DEEPSEEK=
# Claude API key (pay per use), provider "claude-api". Never name it ANTHROPIC_API_KEY: Forge's Claude Code
# would switch to paid API billing.
# ORACLE_KEY_CLAUDE_API=

# Claude subscription (optional): token from `claude setup-token`. Used by Forge, by the provider "claude"
# (Claude abbonamento) and by the external brain mode (same usage limits; needs ORACLE_INSTALL_CLAUDE_CODE=1).
# CLAUDE_CODE_OAUTH_TOKEN=
