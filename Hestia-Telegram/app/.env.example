# Hestia-Telegram — copy to .env (python tools/init_env.py does it).

# REQUIRED: bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# REQUIRED: your numeric Telegram user id (comma-separated list allowed).
# Empty = the bot answers nobody and replies with the sender's id (fail closed).
ALLOWED_USER_ID=

# Optional
TELEGRAM_LOCALE=it
TELEGRAM_SIGNAL_STYLE=minimal
LOG_LEVEL=INFO
