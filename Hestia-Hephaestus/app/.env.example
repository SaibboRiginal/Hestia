SERVICE_NAME=hephaestus
SERVICE_BASE_URL=http://hestia_hephaestus:19010
SERVICE_VERSION=1.0.0
SERVICE_TYPE=core
SERVICE_TAGS=core
HUB_API_URL=http://hestia_hub:19001/api
LOG_LEVEL=INFO

# Telegram chat_id that receives Forge/remediation notices (same as ARGUS_NOTIFY_TARGET)
HEPHAESTUS_NOTIFY_TARGET=

# ── Forge (self-development) ──────────────────────────────────────────
# Engines, all can be configured at the same time:
#   local  = Ollama (or LM Studio) on your PC
#   cloud  = any OpenAI-compatible API (OpenRouter, Gemini, ...)
#   claude = Claude Code CLI (Pro/Max subscription or API key)
# Default used for every task. Switch at runtime from Telegram ("usa il cloud") or
# POST /api/hephaestus/forge/engine — the choice is persisted.
HEPHAESTUS_FORGE_ENGINE=local
# If the chosen default is down (PC off, quota finished), try these in order:
HEPHAESTUS_FORGE_FALLBACK=local,cloud,claude

# local profile — pick a coder model with tool calling (qwen2.5-coder:14b, qwen3-coder, devstral)
HEPHAESTUS_FORGE_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
HEPHAESTUS_FORGE_LOCAL_MODEL=qwen2.5-coder:14b
HEPHAESTUS_FORGE_LOCAL_API_KEY=ollama

# cloud profile — examples:
#   OpenRouter: https://openrouter.ai/api/v1            model qwen/qwen3-coder
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai   model gemini-2.5-flash
HEPHAESTUS_FORGE_CLOUD_BASE_URL=
HEPHAESTUS_FORGE_CLOUD_MODEL=
HEPHAESTUS_FORGE_CLOUD_API_KEY=

# claude — build image with --build-arg INSTALL_CLAUDE_CODE=1.
# Pro/Max subscription: run `claude setup-token` on your PC and paste the token:
CLAUDE_CODE_OAUTH_TOKEN=
# ...or pay-per-use: ANTHROPIC_API_KEY=
HEPHAESTUS_FORGE_CLAUDE_MODEL=

HEPHAESTUS_FORGE_MAX_TURNS=40
HEPHAESTUS_FORGE_AUTO_MERGE=0
HEPHAESTUS_FORGE_AUTO_ROLLBACK=1
HEPHAESTUS_FORGE_PUSH_BRANCH=0
# Deploy after merge (empty = merge only, you restart). Restart via Docker socket (mount it in compose):
# HEPHAESTUS_FORGE_DEPLOY_CMD=for s in {services}; do curl -sf --unix-socket /var/run/docker.sock -X POST http://localhost/containers/hestia_$s/restart || exit 1; done
HEPHAESTUS_FORGE_DEPLOY_CMD=
