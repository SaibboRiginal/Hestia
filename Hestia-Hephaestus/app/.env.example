SERVICE_NAME=hephaestus
SERVICE_BASE_URL=http://hestia_hephaestus:19010
SERVICE_VERSION=1.0.0
SERVICE_TYPE=core
SERVICE_TAGS=core
HUB_API_URL=http://hestia_hub:19001/api
LOG_LEVEL=INFO

# Telegram chat_id that receives Forge/remediation notices (same as ARGUS_NOTIFY_TARGET)
HEPHAESTUS_NOTIFY_TARGET=

# ── Forge (self-development) ──────────────────────────────────────────
# Engine: auto = claude_code if ready, else builtin (Ollama / any OpenAI-compatible API)
HEPHAESTUS_FORGE_ENGINE=auto

# Local: Ollama on the host. Pick a coder model with tool calling (qwen2.5-coder:14b, qwen3-coder, devstral...)
HEPHAESTUS_FORGE_LLM_BASE_URL=http://host.docker.internal:11434/v1
HEPHAESTUS_FORGE_LLM_MODEL=qwen2.5-coder:14b
HEPHAESTUS_FORGE_LLM_API_KEY=ollama
# Cloud via the same builtin engine, e.g. OpenRouter:
#   HEPHAESTUS_FORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
#   HEPHAESTUS_FORGE_LLM_MODEL=qwen/qwen3-coder
#   HEPHAESTUS_FORGE_LLM_API_KEY=sk-or-...
# Gemini (OpenAI-compatible):
#   HEPHAESTUS_FORGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   HEPHAESTUS_FORGE_LLM_MODEL=gemini-2.5-flash

# Claude Code (build image with --build-arg INSTALL_CLAUDE_CODE=1).
# Claude Pro/Max subscription: run `claude setup-token` on your PC, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or pay-per-use API key instead:
# ANTHROPIC_API_KEY=
HEPHAESTUS_FORGE_CLAUDE_MODEL=

HEPHAESTUS_FORGE_MAX_TURNS=40
HEPHAESTUS_FORGE_AUTO_MERGE=0
HEPHAESTUS_FORGE_AUTO_ROLLBACK=1
HEPHAESTUS_FORGE_PUSH_BRANCH=0
# Deploy after merge (empty = merge only, you restart). Restart via Docker socket (mount it in compose):
# HEPHAESTUS_FORGE_DEPLOY_CMD=for s in {services}; do curl -sf --unix-socket /var/run/docker.sock -X POST http://localhost/containers/hestia_$s/restart || exit 1; done
HEPHAESTUS_FORGE_DEPLOY_CMD=
