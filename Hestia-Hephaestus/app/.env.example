SERVICE_NAME=hephaestus
SERVICE_BASE_URL=http://hestia_hephaestus:19010
SERVICE_VERSION=1.0.0
SERVICE_TYPE=core
SERVICE_TAGS=core
HUB_API_URL=http://hestia_hub:19001/api
# Boot log level only; then the setting hephaestus.log.level (WebUI → Impostazioni) wins
LOG_LEVEL=INFO

# Telegram chat_id that receives Forge/remediation notices (empty = only the requester of a Forge task is notified)
HEPHAESTUS_NOTIFY_TARGET=

# ── Forge (self-development) ──────────────────────────────────────────
# Engines: local / cloud = LLM profiles served by ORACLE (configure URLs/keys in
#          Hestia-Oracle .env: ORACLE_LLM_PROFILE_LOCAL_* / ORACLE_LLM_PROFILE_CLOUD_*)
#          claude = Claude Code (Pro/Max) run by Oracle in the shared task worktree
# Tunables are central settings (WebUI → Impostazioni → Hephaestus, stored by Themis): default engine,
# permission modes, fallback order, max turns, timeouts, auto merge/rollback, push branch, verify delay,
# remediation approval/retries. Env keeps only paths, git identity and the test/deploy commands.

# claude = Claude Code run by ORACLE (token CLAUDE_CODE_OAUTH_TOKEN goes in Oracle's .env, not here)

# Deploy after merge (empty = merge only, you restart). Restart via Docker socket (mount it in compose):
# HEPHAESTUS_FORGE_DEPLOY_CMD=for s in {services}; do curl -sf --unix-socket /var/run/docker.sock -X POST http://localhost/containers/hestia_$s/restart || exit 1; done
HEPHAESTUS_FORGE_DEPLOY_CMD=
