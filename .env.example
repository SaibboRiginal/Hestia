# Root .env — read by docker compose for ${VAR} substitution in docker-compose.global.yml.
# Copy to .env (never commit .env). Per-service settings live in Hestia-<Name>/app/.env.

# Postgres password (archive_db + Archive DATABASE_URL). Default keeps existing installs working.
# Applied by Postgres only when the data volume is first created; to change it on an existing DB:
#   docker exec -it hestia_db psql -U hestia_admin -d hestia_memory -c "ALTER USER hestia_admin PASSWORD '<new>';"
# then set it here and restart. Use URL-safe characters (it is embedded in DATABASE_URL).
HESTIA_DB_PASSWORD=super_secret_local_password

# ── Optional (empty = safe default) ─────────────────────────────
# WebUI token signing key (empty = random key generated at start).
WEBUI_SECRET_KEY=
# Shared secret for the WebUI admin API (/api/webui/admin/*), also passed to Telegram.
# Empty = admin API reachable only from the internal Docker network.
WEBUI_ADMIN_SECRET=
# Key (>=16 chars) of the read-only agenda ICS feed for phones; empty = feed only with the login token.
WEBUI_ICS_KEY=
# Named Cloudflare tunnel (cloudflare-tunnel.bat): fixed public address for the WebUI, needed by external AI connectors
# (claude.ai, ChatGPT, Claude Code from outside home). One-time setup in the readme ("Collegare un'AI esterna").
# Empty = quick tunnel with a random trycloudflare.com address at every start.
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_TUNNEL_HOSTNAME=
# Hecate mail watcher (optional; pass them by uncommenting the lines in the compose hecate service).
# Gmail real push through Google Cloud Pub/Sub (streaming pull, no public URL). Empty = 15-min history check only.
# Topic Gmail publishes to (grant publish to gmail-api-push@system.gserviceaccount.com): projects/<project>/topics/<topic>
# HECATE_GMAIL_PUBSUB_TOPIC=
# Pull subscription Hecate reads: projects/<project>/subscriptions/<sub>
# HECATE_GMAIL_PUBSUB_SUBSCRIPTION=
# Service account JSON with only "Pub/Sub Subscriber" (inside the Hecate container; keep the file in Hestia-Hecate/data/).
# HECATE_GMAIL_PUBSUB_CREDENTIALS=/code/data/gmail-pubsub-sa.json
# File of the watcher's Gmail historyId cursor (inside the Hecate container).
# HECATE_MAIL_WATCH_STATE=/code/data/mail_watch.json
# 1 = bake the Claude Code CLI into the Oracle image (used only if CLAUDE_CODE_OAUTH_TOKEN is set); 0 = slimmer image.
ORACLE_INSTALL_CLAUDE_CODE=1
# 1 = bake the Codex CLI into the Oracle image (external brain mode with agent codex, `codex login`); 0 = skip.
ORACLE_INSTALL_CODEX=0

# Raspberry Pi stack only (docker-compose.rpi.yml): SQLAlchemy URL of an external Postgres+pgvector.
# ARCHIVE_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
