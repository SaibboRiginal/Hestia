# Hestia-Scout (real-estate module) — copy to .env (python tools/init_env.py does it).
# Everything is optional; the defaults below match the code.
# Tunables (cycle interval, mail senders/search queries, batching, extraction timeout,
# reconciliation, enrichment, log level) are central settings `scout.*` in Themis
# (Impostazioni in WebUI/Telegram), not env vars.

# Extractor model for new listings: Oracle use case «scout_extraction» (Impostazioni → Oracle → Modelli).
# Boot log level only; the live value is the setting scout.log.level.
LOG_LEVEL=INFO
