# Hestia-Scout (real-estate module) — copy to .env (python tools/init_env.py does it).
# Everything is optional; the defaults below match the code.

# Listing-portal senders to watch (comma-separated); ignored when SCOUT_FILTER_QUERIES is set.
SCOUT_EMAIL_SENDERS=nonrispondere@idealista.it,noreply@notifiche.immobiliare.it
# Explicit mail search queries, separated by "||" (empty = built from SCOUT_EMAIL_SENDERS).
SCOUT_FILTER_QUERIES=
# Extractor model for new listings (routed through Oracle).
SCOUT_LLM_PROVIDER=gemini
SCOUT_LLM_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Batching of new emails sent to the LLM extractor.
SCOUT_MIN_BATCH_SIZE=1
SCOUT_MAX_BATCH_SIZE=5
SCOUT_BATCH_DEBOUNCE_SECONDS=45
SCOUT_BATCH_COOLDOWN_SECONDS=15
SCOUT_LLM_TIMEOUT_SECONDS=120
SCOUT_RECONCILE_EVERY_CYCLES=1
LOG_LEVEL=INFO
